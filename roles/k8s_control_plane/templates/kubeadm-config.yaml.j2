apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ k8s_ip }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ kubeadm_version.stdout }}
# HAProxy + keepalived VIP on the management network (ulx.ops.k8s_api_lb)
controlPlaneEndpoint: "{{ k8s_control_plane_endpoint }}"
networking:
  podSubnet: {{ k8s_pod_cidr }}
  serviceSubnet: {{ k8s_service_cidr }}
apiServer:
  certSANs:
    - {{ k8s_api_fqdn }}
    - {{ k8s_api_vip }}
{% for h in groups['kube_control_plane'] %}
    - {{ h }}
    - {{ hostvars[h].ansible_host }}
    - {{ hostvars[h].k8s_ip }}
{% endfor %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
