apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    nodeAddressAutodetectionV4:
      cidrs: ["{{ k8s_node_cidr }}"]
    ipPools:
      - name: default-ipv4-ippool
        blockSize: 26
        cidr: {{ k8s_pod_cidr }}
        encapsulation: {{ calico_encapsulation }}
        natOutgoing: Enabled
        nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
